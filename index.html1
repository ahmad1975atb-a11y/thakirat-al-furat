.hero-inner{max-width:1100px;margin:40px auto 0}.eyebrow{color:#f2d99e;font-weight:bold}.hero h1{font-size:clamp(30px,6vw,48px);line-height:1.35;margin:8px 0}.hero p{font-size:18px;max-width:720px}.btn{display:inline-block;border:0;border-radius:10px;background:var(--gold);color:#1e3033;padding:10px 16px;text-decoration:none;cursor:pointer;font-weight:bold}.btn.alt{background:white;color:var(--navy)}.wrap{max-width:1100px;margin:auto;padding:22px 16px}.section{margin:26px 0}.section h2{font-size:clamp(23px,4vw,31px);color:var(--navy);margin:0 0 12px}.intro{color:var(--muted);margin-top:0}.searchbox{background:white;border:1px solid var(--line);border-radius:14px;padding:14px;margin:16px 0;display:grid;grid-template-columns:2fr 1fr;gap:12px}.searchbox label{display:block;font-weight:bold}.searchbox input,.searchbox select{width:100%;padding:11px;border:1px solid #d4d9d7;border-radius:9px;background:white;margin-top:5px}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.card{background:white;border:1px solid var(--line);border-radius:15px;padding:17px;box-shadow:0 4px 16px #233b4008}.card h3{margin:0;color:var(--navy);font-size:19px}.card p{margin:7px 0}.card .kind{color:#896a2e;font-size:12px;font-weight:bold}.card button{margin-top:8px}.detail{display:none;background:white;border:1px solid var(--line);border-radius:16px;padding:20px;margin-top:18px}.detail.show{display:block}.detail h2{margin-top:0}.detail p{white-space:pre-line}.detail img{max-width:100%;max-height:340px;object-fit:cover;border-radius:12px;display:block;margin:12px 0}.credit{font-size:12px;color:var(--muted)}.pill{display:inline-block;background:#edf2f1;border-radius:20px;padding:3px 10px;font-size:12px;margin:2px}
